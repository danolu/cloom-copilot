# --- Public site URL ---
# Absolute origin of the deployed app (no trailing path), used as Next.js
# `metadataBase` to resolve Open Graph / Twitter images. Keep localhost for
# local development; set to the production origin (e.g. https://your-domain.com)
# in your hosting provider's environment variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Meta Model API (get a key at https://dev.meta.ai) ---
# Required: without a key the copilot returns a configuration error.
# Every decision runs through the Meta Model API — there is no offline mode.
# Meta's canonical variable name is MODEL_API_KEY; META_API_KEY also works.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Operations Agent Brain & Tool-Calling (Muse Spark series / Muse Spark Open)
META_AGENT_MODEL=muse-spark-1.3

# Executive Insights & Morning Digest (Muse Wonder)
META_DIGEST_MODEL=muse-wonder-1.0

# Voice Notes Audio Transcription (Muse Voice Transcribe)
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
